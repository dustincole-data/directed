---
// src/pages/index.astro
import Base from "../layouts/Base.astro";
import RowStrip from "../components/RowStrip.astro";
import { getRegistry } from "../lib/registry";
import { familyLabel } from "../lib/families";

const reg = getRegistry();

// A row earns a strip once it has something to show: generated cells, or a
// stated gap (a published refusal to guess is a result too). Everything else is
// inventory — real, and worth seeing, but as a list rather than 39 empty rows.
const isShown = (r: (typeof reg.rows)[number]) => r.cells.length > 0 || Boolean(r.gap);

const families = reg.families.map((f) => {
  const rows = f.rows.map((id) => reg.rows.find((r) => r.id === id)!);
  return {
    ...familyLabel(f.family),
    id: f.family,
    shown: rows.filter(isShown),
    planned: rows.filter((r) => !isShown(r)),
    cellCount: rows.reduce((n, r) => n + r.cells.length, 0),
  };
});

const declaredCells = reg.rows.reduce((n, r) => n + r.declaredArms.length, 0);
const builtCells = reg.rows.reduce((n, r) => n + r.cells.length, 0);
const builtRows = reg.rows.filter((r) => r.cells.length > 0).length;
const nullResults = reg.rows.reduce(
  (n, r) => n + r.declaredArms.filter((a) => a.nullResult).length,
  0,
);
---
<Base
  title="Directed — Claude Code's default charts vs. directed ones"
  description="Every element of a data visualization, shown as Claude's default output next to output produced with a specific skill, prompt, or tool actually applied."
>
  <header class="masthead">
    <h1>Directed</h1>
    <p class="masthead__thesis">
      Every element of a chart, made twice or three times over: once by Claude Code
      working from the dataset alone, then again with a named skill or a real tool
      loop run on top. Same model, same data, same module contract. The method is
      the only thing that changes.
    </p>
    <p class="masthead__counts">
      <b>{builtRows}</b> of {reg.rows.length} rows built · <b>{builtCells}</b> of {declaredCells} cells ·
      every cell generated by actually running its method, hashed at generation, and
      re-rendered on every build · <b>{nullResults}</b> published as null results.
    </p>
    <dl class="key">
      <div>
        <dt>Claude default</dt>
        <dd>The dataset and the module contract, nothing else. Three runs; the median by SVG element count ships.</dd>
      </div>
      <div>
        <dt>With a skill</dt>
        <dd>A named skill invoked explicitly, one run, on the default arm's own output.</dd>
      </div>
      <div>
        <dt>With a tool</dt>
        <dd>A real loop — screenshot compare-and-fix, an image model, a charting library. One run.</dd>
      </div>
      <div>
        <dt>refine · from-scratch</dt>
        <dd>Each row declares one. <i>refine</i> runs the directed arms on the default arm's output, so the lever is the only difference; <i>from-scratch</i> generates each arm independently, because there the lever is the generation decision.</dd>
      </div>
    </dl>
  </header>

  <nav class="fnav" aria-label="Families">
    <div class="fnav__inner">
      {families.map((f) => (
        <a href={`#${f.id}`} data-populated={String(f.cellCount > 0)}>{f.name}</a>
      ))}
    </div>
  </nav>

  <div id="gallery">
    {/* A family with nothing built yet is inventory, not gallery: it keeps its
        anchor and every row title, but not the full section furniture. */}
    {families.map((f) => (
      <section class:list={["family", f.shown.length === 0 && "family--planned"]} id={f.id}>
        <div class="family__head">
          <h2>{f.name}</h2>
          <span class="family__count">
            {f.cellCount > 0 ? `${f.shown.length} of ${f.shown.length + f.planned.length} rows · ${f.cellCount} cells` : `${f.planned.length} rows planned`}
          </span>
        </div>
        {f.shown.length > 0 && <p class="family__blurb">{f.blurb}</p>}
        {f.shown.map((row) => <RowStrip row={row} />)}
        {f.planned.length > 0 && (
          <div class="planned">
            {f.shown.length > 0 && <h4>Planned in this family</h4>}
            <ul>
              {f.planned.map((row) => (
                <li><span>{row.title}</span> <b>{row.declaredArms.length} arms</b></li>
              ))}
            </ul>
          </div>
        )}
      </section>
    ))}
  </div>
</Base>
