# Generated cell artifacts must round-trip through checkout unchanged.
# chart.js is hash-verified against cell.json's codeSha256 (verify-cells.mjs
# check 6) — if a checkout on a CRLF-defaulting platform silently rewrites
# its line endings, the hash check false-positives as "code was edited after
# generation" even though nothing changed. Force LF regardless of the
# checking-out machine's core.autocrlf. cell.json and render.svg aren't
# hashed, but they're generated in the same pass and travel with chart.js —
# forcing LF on them too keeps the whole cell bundle internally consistent
# and avoids one file in a cell silently differing from its siblings.
cells/**/chart.js text eol=lf
cells/**/cell.json text eol=lf
cells/**/render.svg text eol=lf

# The fixture JSON is embedded verbatim in every baseline's recorded prompt, and
# the gate (check 10) reads the file back to confirm that. The check normalises
# line endings so a CRLF checkout is not mistaken for a rewritten prompt, but the
# fixtures should still round-trip unchanged — they are the datasets every
# comparison in the gallery rests on.
src/fixtures/*.json text eol=lf
